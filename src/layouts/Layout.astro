---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro"
const navLinks = [
  { label: 'Bookish', href: '#bookish-art' },
  { label: 'Character Art', href: '#character-art' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro Basics</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Comfortaa:wght@300;400;700&family=Raleway:wght@300;400;600;700&display=swap" rel="stylesheet" />
	</head>
	<body>
		<Navbar links={navLinks} />
		<slot />
		<Footer/>
	</body>
</html>

<style>
	html,{
		height: 100%
	}

	body {
		margin: 0 auto;
		width: 100%;
		height: 100%;
		font-family: 'Comfortaa', cursive;
		max-width: 1440px;
		background: #faf7f2;
	}

	h1, h2, h3, h4, h5, h6 {
		font-family: 'Raleway', sans-serif;
		text-transform: uppercase;
	}

	h2 {
		font-size: 120px;
	}
</style>
