---
import { Icon } from 'astro-icon/components';

const socials = [
  { label: 'Instagram', href: 'https://www.instagram.com/blueneekstudio', icon: 'simple-icons:instagram' },
  { label: 'YouTube',   href: 'https://www.youtube.com/@BlueNeekStudio', icon: 'simple-icons:youtube' },
  { label: 'Etsy',      href: 'https://www.etsy.com/shop/BlueNeekStudio',  icon: 'simple-icons:etsy' },
  { label: 'Ko-fi',     href: 'https://ko-fi.com/blueneekstudio',      icon: 'simple-icons:kofi' },
];
---

<div class="socials">
  <p class="socials__heading">Follow me here:</p>
  <div class="socials__icons">
    {socials.map((social) => (
      <a
        class="socials__link"
        href={social.href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={social.label}
      >
        <Icon class="socials__icon" name={social.icon} />
      </a>
    ))}
  </div>
</div>

<style>
  .socials {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .socials__heading {
    margin: 0;
    color: #ffffff;
  }

  .socials__icons {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 1.5rem;
  }

  .socials__link {
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    transition: opacity 0.2s ease;
  }

  .socials__link:hover {
    opacity: 0.7;
  }

  .socials__icon {
    width: 45px;
    height: 45px;
  }
</style>